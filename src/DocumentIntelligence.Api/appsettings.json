{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Extensions.Http": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Auth": {
    "Mode": "Jwt",
    "Authority": "",
    "Audience": "",
    "RequireHttpsMetadata": true,
    "TenantClaim": "tenant_id"
  },
  "Ai": {
    "Provider": "Offline",
    "BaseUrl": "https://api.openai.com/v1",
    "ApiKey": "",
    "ChatModel": "gpt-4o-mini",
    "EmbeddingModel": "text-embedding-3-small",
    "EmbeddingDimensions": 512,
    "Temperature": 0.1,
    "RequestTimeoutSeconds": 120
  },
  "VectorStore": {
    "Provider": "InMemory",
    "Qdrant": {
      "Url": "http://localhost:6333",
      "ApiKey": "",
      "Collection": "documents"
    }
  },
  "Chunking": {
    "MaxTokens": 256,
    "OverlapTokens": 40
  },
  "Retrieval": {
    "DefaultTopK": 5,
    "CandidatesPerRetriever": 30,
    "RrfK": 60,
    "Reranker": "None",
    "RerankCandidates": 20
  },
  "Persistence": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=data/ingestion.db",
    "InitializeOnStartup": true
  },
  "BlobStorage": {
    "Provider": "FileSystem",
    "FileSystem": {
      "RootPath": "data/blobs"
    },
    "AzureBlob": {
      "ConnectionString": "",
      "ContainerName": "documents"
    }
  },
  "QueryCache": {
    "Provider": "Memory",
    "RedisConnection": "",
    "KeyPrefix": "di",
    "TtlSeconds": 300
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topics": {
      "DocumentUploaded": "document-uploaded",
      "DeadLetter": "document-uploaded-dlq",
      "IndexChanged": "document-index-changed"
    },
    "IngestionConsumerGroup": "ingestion-worker",
    "IndexSyncConsumerGroupPrefix": "api-index-sync",
    "CreateTopics": true,
    "TopicPartitions": 3,
    "TopicReplicationFactor": 1
  },
  "Ingestion": {
    "Transport": "InProcess",
    "MaxAttempts": 4,
    "RetryBaseDelayMilliseconds": 1000,
    "RetryMaxDelayMilliseconds": 30000,
    "EmbeddingBatchSize": 32,
    "MaxDocumentBytes": 5242880,
    "QueueCapacity": 100
  }
}
