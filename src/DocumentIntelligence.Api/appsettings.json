{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Extensions.Http": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Ai": {
    "Provider": "Offline",
    "BaseUrl": "https://api.openai.com/v1",
    "ApiKey": "",
    "ChatModel": "gpt-4o-mini",
    "EmbeddingModel": "text-embedding-3-small",
    "EmbeddingDimensions": 512,
    "Temperature": 0.1,
    "RequestTimeoutSeconds": 120
  },
  "VectorStore": {
    "Provider": "InMemory",
    "Qdrant": {
      "Url": "http://localhost:6333",
      "ApiKey": "",
      "Collection": "documents"
    }
  },
  "Chunking": {
    "MaxTokens": 256,
    "OverlapTokens": 40
  },
  "Retrieval": {
    "DefaultTopK": 5,
    "CandidatesPerRetriever": 30,
    "RrfK": 60,
    "Reranker": "None",
    "RerankCandidates": 20
  },
  "BlobStorage": {
    "Provider": "FileSystem",
    "FileSystem": {
      "RootPath": "data/blobs"
    },
    "AzureBlob": {
      "ConnectionString": "",
      "ContainerName": "documents"
    }
  },
  "QueryCache": {
    "Provider": "Memory",
    "RedisConnection": "",
    "KeyPrefix": "di",
    "TtlSeconds": 300
  },
  "Ingestion": {
    "EmbeddingBatchSize": 32,
    "MaxDocumentBytes": 5242880,
    "QueueCapacity": 100
  }
}
