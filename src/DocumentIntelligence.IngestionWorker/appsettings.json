{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Extensions.Http": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*",
  "Ai": {
    "Provider": "Offline",
    "BaseUrl": "https://api.openai.com/v1",
    "ApiKey": "",
    "ChatModel": "gpt-4o-mini",
    "EmbeddingModel": "text-embedding-3-small",
    "EmbeddingDimensions": 512,
    "Temperature": 0.1,
    "RequestTimeoutSeconds": 120
  },
  "VectorStore": {
    "Provider": "Qdrant",
    "Qdrant": {
      "Url": "http://localhost:6333",
      "ApiKey": "",
      "Collection": "documents"
    }
  },
  "Chunking": {
    "MaxTokens": 256,
    "OverlapTokens": 40
  },
  "Persistence": {
    "Provider": "Postgres",
    "ConnectionString": "Host=localhost;Database=document_intelligence;Username=postgres;Password=postgres",
    "InitializeOnStartup": false
  },
  "BlobStorage": {
    "Provider": "FileSystem",
    "FileSystem": {
      "RootPath": "data/blobs"
    }
  },
  "QueryCache": {
    "Provider": "None"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "IngestionConsumerGroup": "ingestion-worker",
    "CreateTopics": true
  },
  "Ingestion": {
    "Transport": "Kafka",
    "EmbeddingBatchSize": 32,
    "MaxAttempts": 4,
    "RetryBaseDelayMilliseconds": 1000,
    "RetryMaxDelayMilliseconds": 30000
  }
}
